{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "options": {
            "groups": [[":BUN:", ":NODE:"]],
            "identifierOrder": "lexicographic"
          },
          "level": "on"
        }
      }
    }
  },
  "files": {
    "includes": [
      "scripts/**/*.{ts,js}",
      "src/**/*.{ts,js}",
      "test/**/*.{ts,js}",
      "tsdown.*.ts",
      "!docs",
      "!dist",
      "!browser/**/*"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto"
  },
  "plugins": ["./lint/no-cross-file-reexport.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noThenProperty": "off",
        "noImportCycles": "error"
      },
      "complexity": { "noVoid": "error" },
      "style": { "noExportedImports": "error" }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "always",
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
