{
  "name": "@meld-ts/core",
  "description": "A collection of utility functions for TypeScript",
  "version": "1.0.3",
  "type": "module",
  "files": [
    "./dist",
    "./browser"
  ],
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "meld-ts": "./dist/bin/meld-ts.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./a11y": {
      "import": "./dist/a11y/index.js",
      "require": "./dist/a11y/index.cjs"
    },
    "./async": {
      "import": "./dist/async/index.js",
      "require": "./dist/async/index.cjs"
    },
    "./events": {
      "import": "./dist/events/index.js",
      "require": "./dist/events/index.cjs"
    },
    "./path": {
      "import": "./dist/path.js",
      "require": "./dist/path.cjs"
    },
    "./singleton": {
      "import": "./dist/singleton.js",
      "require": "./dist/singleton.cjs"
    },
    "./timer": {
      "import": "./dist/timer.js",
      "require": "./dist/timer.cjs"
    },
    "./traits": {
      "import": "./dist/traits/index.js",
      "require": "./dist/traits/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "typescript",
    "utility",
    "functions",
    "utils",
    "type-guards",
    "async",
    "traits"
  ],
  "author": "Jiankai Zeng <janpoem@163.com>",
  "contributors": [
    {
      "name": "KAI@AI-SOUL"
    },
    {
      "name": "思源@AI-SOUL"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/meld-ts/core.git"
  },
  "homepage": "https://meld-ts.github.io/core/",
  "license": "MIT",
  "scripts": {
    "prepare": "lefthook install",
    "fmt": "biome check --write --linter-enabled=false ./src ./test ./scripts ./tsdown.config.ts ./tsdown.browser.ts ./tsdown.bin.ts",
    "lint": "biome lint --error-on-warnings ./src ./test ./scripts ./tsdown.config.ts ./tsdown.browser.ts ./tsdown.bin.ts",
    "ts-check": "tsc --noEmit",
    "test": "bun test src/ lint/ --coverage",
    "a11y:sync": "bun scripts/a11y-sync.ts",
    "test:a11y-lint": "bun scripts/a11y-lint-test.ts",
    "test:a11y-build": "bun scripts/a11y-build-test.ts",
    "build:browser": "tsdown --config tsdown.browser.ts",
    "build:dist": "tsdown",
    "build:bin": "tsdown --config tsdown.bin.ts",
    "clean": "rm -rf dist browser",
    "build": "bun run clean && bun run build:browser && bun run build:dist && bun run build:bin",
    "doc": "bun typedoc --options typedoc.json --cleanOutputDir",
    "doc:watch": "bun typedoc  --options typedoc.json --watch",
    "biome-migrate": "bunx biome migrate --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "latest",
    "lefthook": "^2.1.9",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.19",
    "typedoc-material-theme": "^1.4.1",
    "typedoc-plugin-expand-object-like-types": "^0.1.2",
    "typedoc-plugin-merge-modules": "^7.0.0",
    "typescript": "5.9.3"
  }
}
