{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "root": false,
  "plugins": ["../no-cross-file-reexport.grit"],
  "linter": {
    "enabled": true,
    "rules": { "preset": "none", "style": { "noExportedImports": "error" } }
  },
  "files": { "includes": ["**"] },
  "formatter": { "enabled": false },
  "assist": {
    "enabled": false,
    "actions": { "source": { "organizeImports": "off" } }
  }
}
